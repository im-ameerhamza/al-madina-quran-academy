<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>


<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>


<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|svg|png|jpe?g|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>


# ==========================================
# SEO Friendly URLs
# ==========================================

RewriteEngine On

# Use the custom 404 page for any URL that doesn't match a real
# file/directory or one of the rewrite rules below.
ErrorDocument 404 /version2/404.php

# ------------------------------------------
# Main pages (clean URLs)
# ------------------------------------------
RewriteRule ^about-us/?$ about.php [L,QSA]
RewriteRule ^courses/?$ popular-courses.php [L,QSA]
RewriteRule ^fee-structure/?$ fee-structure.php [L,QSA]
RewriteRule ^educators/?$ educators.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]

# Old .php URLs redirect to the new clean URL (avoids duplicate-content issues)
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^index\.php$ /version2/ [L,R=301]

RewriteCond %{THE_REQUEST} \s/about\.php[\s?] [NC]
RewriteRule ^about\.php$ /version2/about-us [L,R=301]

RewriteCond %{THE_REQUEST} \s/popular-courses\.php[\s?] [NC]
RewriteRule ^popular-courses\.php$ /version2/courses [L,R=301]

RewriteCond %{THE_REQUEST} \s/fee-structure\.php[\s?] [NC]
RewriteRule ^fee-structure\.php$ /version2/fee-structure [L,R=301]

RewriteCond %{THE_REQUEST} \s/educators\.php[\s?] [NC]
RewriteRule ^educators\.php$ /version2/educators [L,R=301]

RewriteCond %{THE_REQUEST} \s/contact\.php[\s?] [NC]
RewriteRule ^contact\.php$ /version2/contact [L,R=301]

# ------------------------------------------
# Course detail pages (slug -> id lookup)
# ------------------------------------------

# Course ID 1
RewriteRule ^noorani-qaida/?$ course-details.php?id=1 [L,QSA]

# Course ID 2
RewriteRule ^nazra-quran-with-tajweed/?$ course-details.php?id=2 [L,QSA]

# Course ID 3
RewriteRule ^hifz-e-quran-with-tajweed/?$ course-details.php?id=3 [L,QSA]

# Course ID 4
