# Old course-details.php?id=X links redirect to the pretty slug URL
RewriteCond %{THE_REQUEST} \s/course-details\.php\?id=1(&|\s) [NC]
RewriteRule ^course-details\.php$ /version2/noorani-qaida [L,R=301]
